# Copy to .env and adjust. Every value below is a default unless marked required.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
REQUEST_TIMEOUT=60s
SHUTDOWN_GRACE=10s
# Comma separated. Leave empty to send no CORS headers, which is what a
# same-origin or server-rendered client wants.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Shared secret. Also the fallback token the MCP tool server presents on
# internal callbacks when BUDDI_TOOL_TOKEN is not set.
SECRET_KEY=
# Must be at least 32 bytes when ENVIRONMENT is anything but development.
JWT_SECRET=
JWT_ISSUER=buddi
# Access token lifetime. Kept short so a leaked token expires on its own.
JWT_EXPIRY=15m
# Refresh tokens are opaque random strings, not JWTs, so there is no refresh
# signing key. Only their lifetime is configured.
REFRESH_EXPIRY=168h
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URI=postgres://buddi:buddi@localhost:5432/buddi?sslmode=disable
MIGRATE_ON_START=true
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
DB_SLOW_QUERY_THRESHOLD=200ms

# ---------------------------------------------------------------------------
# Ollama (containerised: `docker compose --profile llm up -d ollama`)
# ---------------------------------------------------------------------------
# Correct for a host-run API talking to the published port. If the API itself
# runs in a container on the same Compose network, use http://ollama:11434.
BUDDI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# One general model only. Larger tiers were evaluated and dropped: without a GPU
# the weights and KV cache come out of the same RAM, and the extra quality is not
# needed here.
BUDDI_MODEL=qwen3:0.6b
# Optional planning-only override. Empty means BUDDI_MODEL is used.
BUDDI_PLANNER_MODEL=
BUDDI_EMBED_MODEL=nomic-embed-text
# The KV cache grows with context. 8192 is ample for planning and retrieval
# and is the single biggest memory lever after the weights themselves.
BUDDI_OLLAMA_CONTEXT_LENGTH=8192
BUDDI_OLLAMA_TEMPERATURE=0.2
BUDDI_OLLAMA_KEEP_ALIVE=2m
BUDDI_OLLAMA_TIMEOUT=2m
# Re-asks a schema-invalid plan with the validation errors appended.
BUDDI_PLAN_MAX_RETRIES=1
# Reasoning level the planner asks for: low, medium, high, or empty.
#
# The runtime rejects think=false alongside a schema, which is the only way to get
# cheap structured output, so a reasoning model needs a level rather than an off
# switch. Set this empty when BUDDI_PLANNER_MODEL is a non-thinking instruct
# model: it exposes no reasoning to cap, and asking it to reason anyway spends the
# whole token budget without producing an answer.
BUDDI_PLANNER_THINK=low

# Agent ----------------------------------------------------------
# Bounds one planning call. Planning is answered synchronously, so this must stay
# under REQUEST_TIMEOUT: if the model outlives the server's write timeout the
# client gets a truncated response and the run's outcome is never recorded.
BUDDI_AGENT_PLAN_TIMEOUT=45s

# ---------------------------------------------------------------------------
# MCP tool server
# ---------------------------------------------------------------------------
MCP_BINARY_PATH=buddi-mcp-tasks
# Overrides SECRET_KEY for internal callbacks. Set a distinct value in any
# shared environment.
BUDDI_TOOL_TOKEN=
BUDDI_MCP_TOOL_TIMEOUT=30s
BUDDI_MCP_RUN_TIMEOUT=5m

# ---------------------------------------------------------------------------
# OAuth connectors (optional)
# ---------------------------------------------------------------------------
# Enabling this registers the Google Calendar connector. Leave empty to run with
# connectors off. Hex or base64 decoding to exactly 32 bytes: `openssl rand -hex 32`.
# It seals stored access/refresh tokens (AES-256-GCM), so it is a third secret,
# independent of SECRET_KEY and JWT_SECRET, and can be rotated on its own.
OAUTH_ENCRYPTION_KEY=
# How long before a token's expiry it is refreshed. Defaults to 2m and cannot be
# set beyond the refresh credential's own lifetime.
OAUTH_REFRESH_MARGIN=2m
# Where the OAuth callback sends the browser back to. Must be an origin: scheme, host
# and port with no path. Defaults to the Vite dev server.
#
# Google OAuth application credentials. All three are required: without any of them
# the connector is not registered, and the log names which one is missing.
#
# To create them, in the Google Cloud console:
#   1. Create a project, then enable the Google Calendar API.
#   2. Configure the OAuth consent screen. While the app is in "Testing" mode you must
#      add yourself as a test user: Google then shows a warning screen instead of the
#      consent one, and only accounts on the list can connect.
#   3. Create an OAuth client of type "Web application".
#   4. Set the authorised redirect URI to exactly GOOGLE_REDIRECT_URL below. A
#      mismatch fails with an opaque redirect_uri error rather than anything clearer.
#
# The redirect URI is this service's own callback:
#   http://localhost:8000/api/v1/connections/google_calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/connections/google_calendar/callback

# Consent screen publishing status: which of these two you pick changes real
# behaviour, so it is worth being deliberate.
#
#   "In production" (recommended while unverified)
#     Any Google account can authorize. Refresh tokens do not expire on a schedule.
#     Users see a dismissible "Google hasn't verified this app" warning, and the app
#     is capped at 100 total users. No verification needed for this.
#
#   "Testing"
#     Only accounts you add under "Test users" can authorize, up to 100 of them.
#     Refresh tokens EXPIRE 7 DAYS AFTER CONSENT, so the connector will need
#     reconnecting every week. This is the setting most likely to surprise you.
#
# The calendar scope is "sensitive" rather than "restricted", so unverified apps are
# allowed to request it. Restricted scopes (Drive, Gmail) would need verification.
BUDDI_WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Unset or empty disables export entirely and leaves a no-op pipeline in place.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=buddi-api
OTEL_TRACES_SAMPLER_ARG=1

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Must match the vector column width in the schema, which is fixed at 768 for
# nomic-embed-text.
EMBED_DIMENSIONS=768
CHUNK_TOKENS=500
CHUNK_OVERLAP=50
# The embedder's own input ceiling. Ollama truncates anything longer without
# reporting it, so this must stay at or above CHUNK_TOKENS.
EMBED_MAX_TOKENS=8192
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3

# Background indexing. A note is embedded inline when it is saved, so this worker's
# job is the notes the inline attempt could not finish: a runtime that was down, a
# model still loading, or a process that died mid-note.
INDEX_BATCH_SIZE=20
# How long to wait when there is nothing to do. This is also the worst-case delay
# between saving a note and it becoming searchable, on the retry path.
INDEX_INTERVAL=5s
# How long a claimed note stays out of reach of other workers. Must exceed the
# slowest embedding call the runtime can make, or two workers index the same note.
INDEX_LEASE=2m