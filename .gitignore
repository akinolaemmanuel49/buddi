# Secrets and machine-local configuration.
#
# buddi-api/.env holds SECRET_KEY, JWT_SECRET, the OAuth encryption key and the Google
# client secret. It is never committed; .env.example is the committed template.
.env
.env.local
.env.*.local

# Build output.
buddi-web/node_modules/
buddi-web/dist/
buddi-web/.vite/
*.exe

# Go build scratch.
buddi-api/tmp/
buddi-api/server

# Coverage and profiling.
*.out
*.test
coverage.*

# Editor and OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp